[Unit]
Description=yt-upload - Automatisierter YouTube Upload Workflow
Documentation=https://github.com/chaos7x/yt-upload
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yt-upload
Group=yt-upload
SupplementaryGroups=media-pipeline
ExecStart=/usr/bin/yt-upload -D
Restart=on-failure
RestartSec=5

# --- Hardening ---
# ReadWritePaths deckt genau das ab, was der Daemon tatsaechlich beschreibt:
# /srv/media-pipeline (IN_DIR/WORK_DIR/DONE_DIR/CORRUPT_DIR/RETRY_DIR),
# /var/log/yt-upload (Standard-Logpfad, siehe config.py:_default_log_file()) und
# /etc/yt-upload (CREDENTIALS_FILE-Berechtigungskorrektur per os.chmod, siehe
# youtube_api.get_access_token() - nur relevant, wenn CREDENTIALS_FILE/
# upload.conf tatsaechlich auf einen Pfad darunter zeigen). Wer abweichende
# Pfade konfiguriert (LOG_FILE/CREDENTIALS_FILE/IN_DIR/...), muss sie hier
# ergaenzen, sonst schlaegt der jeweilige Schreibzugriff fehl.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/media-pipeline /var/log/yt-upload /etc/yt-upload
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
# TCP/IP fuer die YouTube/Google-API via requests, plus AF_UNIX: Hostname-
# Aufloesung kann je nach Distro-Konfiguration ueber die klassische
# nss-dns-Direktabfrage (reines AF_INET/AF_INET6) ODER ueber nss-resolve
# laufen, das per lokalem Unix-Socket mit systemd-resolved spricht - ohne
# AF_UNIX waere DNS-Aufloesung auf Hosts mit aktivem systemd-resolved
# stillschweigend kaputt. inotify nutzt reine Syscalls (kein Socket),
# Logging nur Datei/stdout (kein Syslog-Socket).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
