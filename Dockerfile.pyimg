# ==========================================
# STUFE 0: Statische Binaries bereitstellen
# ==========================================
# Holt die offiziellen, statisch gelinkten FFmpeg- und FFprobe-Binaries von mwader
FROM mwader/static-ffmpeg:latest AS ffmpeg-binaries

# ==========================================
# STUFE 1: Builder - installiert yt_upload (+ get_token) und alle
# Laufzeit-Abhängigkeiten isoliert per pip
# ==========================================
# Anders als vorher (pip direkt im finalen Image): auch dieses Image baut
# bewusst komplett auf pip auf (kein apt/apk-Äquivalent für requests/inotify
# hier gewünscht), aber pip/setuptools UND die Build-Toolchain sollen trotzdem
# nicht im Laufzeit-Image landen. --target sammelt daher alle Pakete (eigenes
# Package + requests + inotify + deren jeweilige Abhängigkeiten) flach in
# einem Ordner, den die Final-Stage gezielt übernimmt (siehe LAYER 3 dort).
FROM python:3-slim AS builder

WORKDIR /build
COPY pyproject.toml /build/pyproject.toml
COPY src/ /build/src/
# ".[daemon]" installiert das eigene Package UND requests/inotify in einem
# Rutsch, direkt aus den in pyproject.toml deklarierten Dependencies - keine
# doppelte Pflege der Paketnamen an zwei Stellen.
RUN pip install --no-cache-dir --break-system-packages --target=/install ".[daemon]"

# ==========================================
# STUFE 2: FINAL STAGE (Schlankes Laufzeit-Image, kein pip/setuptools)
# ==========================================
FROM python:3-slim

# ------------------------------------------
# LAYER 1: FFmpeg Binaries aus STUFE 0 kopieren
# ------------------------------------------
COPY --from=ffmpeg-binaries /ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg-binaries /ffprobe /usr/local/bin/ffprobe

# ==========================================
# LAYER 2: System-Tools & C-Bibliotheken über apt
# ==========================================
# Installiert ExifTool, Midnight Commander (mc)
# sowie ca-certificates direkt über den Paketmanager. Bewusst OHNE pip/
# setuptools - die werden nur im Builder (STUFE 1) gebraucht.
# apt-get upgrade: das Base-Image selbst hinkt Debians eigenen Security-
# Patches oft ein paar Tage hinterher, bis die Docker-Official-Images-
# Pipeline es neu baut - ein simples `docker pull` holt dann weiterhin die
# alte, unpatchte Version. apt-get upgrade zieht stattdessen bei jedem
# Build die aktuell in Debians eigenen Repos verfügbaren Paketversionen.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    libcom-err2 \
    mc \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------
# LAYER 2b: Dedizierter Non-Root-User
# ------------------------------------------
# Gehärtetes Image: laeuft standardmaessig nicht als root, auch wenn beim
# Deploy kein `user:`/`-u` gesetzt wird. UID/GID bewusst NICHT fest kodiert -
# useradd/groupadd (statt adduser, das im -slim-Base-Image fehlt und den
# Build mit "exit code: 127" scheitern liess) waehlen automatisch eine freie
# System-UID <1000. Wer die UID an sein eigenes Setup anpassen will (z.B.
# fuer Bind-Mount-Rechte), ueberschreibt sie ganz normal per `docker run -u`/
# Compose `user:` - die 1777-Verzeichnisse unten bleiben davon unabhaengig
# fuer jede UID beschreibbar.
RUN groupadd --system yt-upload \
    && useradd --system --no-create-home --home /nonexistent \
        --shell /usr/sbin/nologin --gid yt-upload yt-upload

# Arbeitsverzeichnis & Home-Variable setzen
WORKDIR /app
ENV HOME=/app

# ------------------------------------------
# LAYER 3: yt_upload-Package + Python-Abhängigkeiten aus dem Builder übernehmen
# ------------------------------------------
# Gezielt einzeln statt das komplette /install-Verzeichnis zu übernehmen:
# das inotify-Paket deklariert fälschlich "build" (samt dessen eigenen
# Abhängigkeiten packaging/pyproject_hooks) als Laufzeit-Dependency, obwohl
# es nirgends importiert wird (nur zum Wheel-Bauen gebraucht) - das würde
# sonst ungenutzt im Laufzeit-Image landen. get_token wird bewusst NICHT aus
# dem Builder übernommen (siehe LAYER 5 - eigenständiger Bare-Datei-Kopie
# statt des pip-Installs, damit es unabhängig vom yt_upload-Package bleibt).
COPY --from=builder /install/bin/yt-upload /usr/local/bin/yt-upload
COPY --from=builder /install/bin/get-token /usr/local/bin/get-token
COPY --from=builder /install/yt_upload /usr/local/lib/yt-upload/yt_upload
COPY --from=builder /install/yt_upload-*.dist-info /usr/local/lib/yt-upload/yt_upload.dist-info
COPY --from=builder /install/get_token /usr/local/lib/yt-upload/get_token
COPY --from=builder /install/requests /usr/local/lib/yt-upload/requests
COPY --from=builder /install/requests-*.dist-info /usr/local/lib/yt-upload/requests.dist-info
COPY --from=builder /install/urllib3 /usr/local/lib/yt-upload/urllib3
COPY --from=builder /install/urllib3-*.dist-info /usr/local/lib/yt-upload/urllib3.dist-info
COPY --from=builder /install/idna /usr/local/lib/yt-upload/idna
COPY --from=builder /install/idna-*.dist-info /usr/local/lib/yt-upload/idna.dist-info
COPY --from=builder /install/certifi /usr/local/lib/yt-upload/certifi
COPY --from=builder /install/certifi-*.dist-info /usr/local/lib/yt-upload/certifi.dist-info
COPY --from=builder /install/charset_normalizer /usr/local/lib/yt-upload/charset_normalizer
COPY --from=builder /install/charset_normalizer-*.dist-info /usr/local/lib/yt-upload/charset_normalizer.dist-info
COPY --from=builder /install/inotify /usr/local/lib/yt-upload/inotify
COPY --from=builder /install/inotify-*.dist-info /usr/local/lib/yt-upload/inotify.dist-info
ENV PYTHONPATH=/usr/local/lib/yt-upload

# ------------------------------------------
# LAYER 4: Daten- & Log-Verzeichnisse anlegen
# ------------------------------------------
# 1777 statt 777: die Laufzeit-UID ist unbekannt (frei wählbar via `docker run -u`,
# um Berechtigungskonflikte mit host-gemounteten Verzeichnissen zu vermeiden),
# daher müssen beide Verzeichnisse für jede UID beschreibbar bleiben. Das
# Sticky-Bit (wie bei /tmp) verhindert aber, dass ein Prozess/Nutzer Dateien
# löschen oder umbenennen kann, die ein anderer angelegt hat.
RUN mkdir -p /videos /log /etc/yt-upload/conf.d /srv/media-pipeline/incoming /srv/media-pipeline/work /srv/media-pipeline/done /srv/media-pipeline/corrupt /srv/media-pipeline/retry \
    && chmod 1777 /videos /log /srv/media-pipeline/incoming /srv/media-pipeline/work /srv/media-pipeline/done /srv/media-pipeline/corrupt /srv/media-pipeline/retry

# ------------------------------------------
# LAYER 5: Lokale Skripte & Configs kopieren
# ------------------------------------------
COPY bashrc /etc/global.bashrc
COPY --chmod=755 src/get_token/get_token.py /usr/local/bin/get_token
COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh
COPY upload.conf.example /etc/yt-upload/upload.conf

# ------------------------------------------
# LAYER 6: Symlinks anlegen
# ------------------------------------------
RUN ln -s /etc/global.bashrc /tmp/.bashrc \
    && ln -s /etc/global.bashrc /app/.bashrc

# /app gehoert dem dedizierten User statt root, damit HOME=/app (siehe oben)
# fuer ihn tatsaechlich beschreibbar ist.
RUN chown yt-upload:yt-upload /app
USER yt-upload

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/yt-upload", "--healthcheck"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

ARG VERSION
ARG BUILD_DATE

LABEL version="${VERSION}"
LABEL build_date="${BUILD_DATE}"
LABEL maintainer="Chaos7x"
LABEL purpose="YouTube upload automation with ffmpeg + python"
