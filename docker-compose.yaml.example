services:
  yt-upload:
    image: ghcr.io/chaos7x/yt-upload:${IMAGE_VERSION:-latest}
    container_name: yt-upload
    hostname: yt-upload
    restart: unless-stopped

    security_opt:
      - no-new-privileges:true

    # 1. Das User-Mapping erzwingen (optional, aber Best Practice für Docker)
    user: "11107:11108"
    environment:
      - TZ=Europe/Berlin
      - ENABLE_DYNAMIC_PLAYLISTS=true
      - HOME=/tmp  # Hält Schreibzugriffe für Caches/Config aus dem :ro gemounteten /app fern
      # IN_DIR liegt bewusst *innerhalb* des einen yt-upload-data-Mounts unten
      # statt in einem eigenen Volume - spart einen zweiten Bind-Mount, da
      # fetchbridge (siehe dessen docker-compose.yaml.example) einfach direkt
      # in den "in"-Unterordner desselben Host-Verzeichnisses schreiben kann.
      - IN_DIR=/srv/yt-upload/in
    env_file:
      - .env
    volumes:
      # 1. Den App-Ordner (inklusive deiner lokalen upload.sh) einbinden
      # - app:/app:ro

      # 2. OAuth-Konfiguration für tokland/youtube-upload
      # Da tokland standardmäßig in ~/.config/youtube-upload sucht und wir HOME=/app gesetzt haben,
      # sucht das Tool die Client-Secrets nun unter /app/oauth
      - oauth:/app/oauth

      # 3. Kompletter Datenzustand (in/work/done/corrupt/retry) in einem
      # einzigen Bind-Mount statt zwei getrennten Volumes - IN_DIR zeigt
      # oben per ENV auf den "in"-Unterordner, in den fetchbridges
      # storage-target direkt hineinschreibt (derselbe Host-Pfad + "/in").
      - yt-upload-data:/srv/yt-upload

      # 4. Log Verzeichnis
      - log:/log

    # Podman + Docker kompatibel
    tty: true
    stdin_open: true

    # 4. keep-id entfernen oder auskommentieren!
    # Da wir nun mit einem echten Docker-Daemon arbeiten und den Container direkt
    # auf deine UID mappen, wird "keep-id" (das ein reines Podman-Feature ist) nicht mehr benötigt.
    # userns_mode: "keep-id"
    networks:
      - default

# ==========================================
# Healthcheck (optional), ist aktiviert
# ==========================================
#    healthcheck:
#      test: ["CMD", "python3", "/app/yt-upload", "--healthcheck"]
#      interval: 30s
#      timeout: 5s
#      start_period: 15s
#      retries: 3

volumes:
  app:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "./app"

  oauth:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "./oauth"

  yt-upload-data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "./yt-upload-data"

  log:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "./log"

